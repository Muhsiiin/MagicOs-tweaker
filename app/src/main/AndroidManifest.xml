<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="MagicOS Tweaker"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        
        <activity
            android:name="com.muhsiin.magicos_tweaker.MainActivity"
            android:exported="true"
            android:label="MagicOS Tweaker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Properly registered content provider for automatic Shizuku IPC binding -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.muhsiin.magicos_tweaker.shizuku"
            android:exported="false"
            android:multiprocess="false" />
            
    </application>

</manifest>
